    "peer.status.searching" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Searching for the iPhone" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneを検索しています" } } } },
    "peer.status.connected" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続しました" } } } },
    "peer.status.connecting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connecting" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続中" } } } },
    "peer.status.reconnecting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnecting" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "再接続しています" } } } },
    "peer.status.sendFailed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not send; will retry when connected" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "送信できません。接続後に再試行します" } } } },
    "peer.status.invalidResponse" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Received an unexpected response; the command remains queued" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "予期しない応答を受信しました。操作はキューに保持します" } } } },
    "peer.status.responseTimedOut" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No response; the command will retry after reconnecting" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "応答がありません。再接続後に操作を再試行します" } } } },
    "peer.status.queueFull" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Offline command queue is full. Reconnect to send saved actions before adding more." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフライン操作キューが上限です。保存済み操作を送るため接続してください" } } } },
    "peer.status.storageError" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not save the pending commands" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "同期待ちの操作を保存できませんでした" } } } },
    "peer.status.processingError" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The iPhone could not process the command" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneで操作を処理できませんでした" } } } },
    "counter.quickAdd" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quick add" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "まとめて追加" } } } },
    "settings.peer.connect" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to iPhone" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneに接続" } } } },
    "settings.peer.dashboard" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open remote counters" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートカウンターを開く" } } } },
    "settings.peer.enable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow iPad connection" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPad接続を有効にする" } } } },
    "settings.peer.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "iPad connection" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPad連携" } } } },
    "settings.peer.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create a code on iPhone, then enter it on your iPad. Treat it as a secret, share it only with your own iPad, and remove it in Settings before deleting the app." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneでコードを作成し、自分のiPadで入力してください。秘密情報として自分のiPadだけに共有し、アプリ削除前に設定からコードを削除してください。" } } } },
    "settings.peer.changeCode.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Change pairing code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードの変更" } } } },
    "settings.peer.changeCode.confirm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Switch to new code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "別のコードに切り替える" } } } },
    "settings.peer.changeCode.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pending commands stay in the queue tied to the previous code; they are not moved to the new code. Re-enter the same code to resume sending them." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "未送信の操作は前のコードに紐づいたキューに残り、新しいコードへは移動しません。同じコードを再入力すると送信を再開できます。" } } } },
    "settings.peer.replaceCode.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replace pairing code?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを作り直しますか？" } } } },
    "settings.peer.replaceCode.confirm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replace code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コードを作り直す" } } } },
    "settings.peer.replaceCode.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This stops connections using the current code. Unsent iPad commands stay in the queue for the old code and are not moved. Keep a secure copy of the current code before continuing if you may need to resume sending them." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のコードを使う接続が停止します。iPadの未送信操作は旧コード用のキューに残り、新しいコードへは移りません。再送信が必要な場合に備え、続行前に現在のコードを安全な場所に控えてください。" } } } },
    "settings.peer.removeCode.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove pairing code?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを削除しますか？" } } } },
    "settings.peer.removeCode.confirm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コードを削除" } } } },
    "settings.peer.removeCode.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Removing the code stops the connection. Unsent iPad commands remain in the queue for this code. Keep a secure copy of the code before removing it if you may need to reconnect." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コードを削除すると接続が停止します。iPadの未送信操作はこのコード用のキューに残ります。再接続する可能性がある場合は、削除前にコードを安全な場所に控えてください。" } } } },
    "settings.peer.enterExistingCode" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter an existing 64-character code to restore pairing" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存済みの64桁コードでペアリングを復元" } } } },
    "settings.peer.restoreCode" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use this existing code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このコードを使う" } } } },
    "settings.peer.restoreCode.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore pairing with this code?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このコードでペアリングを復元しますか？" } } } },
    "settings.peer.restoreCode.confirm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore pairing" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングを復元" } } } },
    "settings.peer.restoreCode.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This replaces the current code and stops its connection. Use the same code on both devices to resume commands waiting for that code. Commands for another code stay in their original queue." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のコードが置き換わり、その接続は停止します。復元するコードを両方の端末で使うと、そのコード用の保留操作を再送できます。別のコード用の操作は元のキューに残ります。" } } } },
    "settings.peer.enterCode" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "64-character pairing code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "64桁のペアリングコード" } } } },
    "settings.peer.activate" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save pairing code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを保存" } } } },
    "settings.peer.paired" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pairing code saved" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コードを保存しました" } } } },
    "settings.peer.unassignedCommandsNotice" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "These older commands have no recorded pairing destination and will not be sent automatically." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "以前の操作には接続先の記録がありません。自動送信されません。" } } } },
    "settings.peer.unassignedCommandsError" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The older pending-command file could not be read and has been left untouched." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "以前の操作ファイルを読み込めないため、変更せずに保持しています。" } } } },
    "settings.peer.unassignedCommands" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unassigned pending commands" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続先未設定の保留操作" } } } },
    "settings.peer.reassignLegacy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Assign to this iPhone" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このiPhoneに割り当てる" } } } },
    "settings.peer.reassignLegacy.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Send older commands to this iPhone?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "以前の操作をこのiPhoneに送信しますか？" } } } },
    "settings.peer.reassignLegacy.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The original destination is unknown. Assigning them here will queue them for this pairing." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "元の接続先は不明です。割り当てると、このペアリング先への送信待ちになります。" } } } },
    "settings.peer.reassignLegacy.confirm" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Assign and queue commands" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "割り当てて送信待ちにする" } } } },
    "settings.peer.shareCode" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Share pairing code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを共有" } } } },
    "settings.peer.generateCode" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create pairing code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを作成" } } } },
    "settings.peer.remove" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove pairing code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを削除" } } } },
    "settings.peer.error" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pairing code error" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードのエラー" } } } },
    "settings.peer.errorMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The pairing code could not be saved. Check that it contains exactly 64 hexadecimal characters." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードを保存できませんでした。16進数64文字か確認してください。" } } } },
    "settings.theme" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Theme" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "テーマ" } } } },
    "settings.currentTheme" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current theme" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のテーマ" } } } },
    "settings.privacy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Data and privacy" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "データとプライバシー" } } } },
    "settings.privacy.localStorage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stored locally" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカルに保存" } } } },
    "settings.privacy.localStorageDescription" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Records stay in app storage without Factory Tools sync. Apple may include app data in device backups when you enable them." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "記録はアプリ内に保存され、Factory Toolsでは同期しません。端末バックアップを有効にすると、Appleのバックアップに含まれる場合があります。" } } } },
    "settings.privacy.sharingDescription" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Backups and CSV files are shared only after you choose a destination in the system share sheet." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップやCSVは、システムの共有画面で保存先を選んだときに書き出されます。" } } } },
    "settings.privacy.details" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy details" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライバシーの詳細" } } } },
    "settings.privacy.details.local.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Storage on your devices" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "端末内の保存" } } } },
    "settings.privacy.details.local.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Homes, counts, settings, and histories are stored locally; Factory Tools does not sync them through CloudKit or its own server. Apple may include app data in iPhone or iPad backups when you enable iCloud or computer backups. Apple Watch also stores active Cycle Time timer state and pending commands and samples locally; Apple Watch backups are included with the paired iPhone backup." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホーム、生産数、設定、履歴は各端末に保存し、CloudKitやFactory Toolsのサーバーでは同期しません。iCloudまたはコンピュータの端末バックアップを有効にすると、Appleのバックアップにアプリデータが含まれる場合があります。Apple Watchは計測中のサイクルタイム状態と未送信の操作・記録も端末内に保存します。Apple Watchのバックアップはペアリング済みiPhoneのバックアップに含まれます。" } } } },
    "settings.privacy.details.devices.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Paired Apple devices" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングしたAppleデバイス" } } } },
    "settings.privacy.details.devices.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Counter commands go directly between your paired iPhone, Apple Watch, and iPad. Apple Watch also sends Cycle Time samples directly to iPhone. While Pro is active, the iPhone sends the home name, production count, and target for Watch-enabled Production Progress cards. The iPhone keeps the canonical production history. An iPad pairing secret is stored in Keychain." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "カウンター操作は、ペアリングしたiPhone・Apple Watch・iPad間で直接送受信されます。Apple Watchからはサイクルタイム記録もiPhoneへ直接送信されます。Pro利用中は、Watch表示を有効にした生産進捗カードのホーム名・生産数・目標数もiPhoneからWatchへ送信されます。正式な数量と履歴はiPhoneに保存されます。iPadのペアリングコードはKeychainに保存されます。" } } } },
    "settings.privacy.details.export.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exports" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き出し" } } } },
    "settings.privacy.details.export.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "JSON backups and CSV files are prepared when you request an export. The system share sheet lets you choose where each file goes. Exports do not include unsent Watch or iPad commands or an active Watch timer. Sync pending device data before deleting or reinstalling the app." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "JSONバックアップとCSVは、書き出しを選んだときに作成されます。ファイルの保存先や送信先はシステムの共有画面で選べます。書き出しにはWatch／iPadからの未送信操作やWatchの計測中タイマーは含まれません。アプリを削除または再インストールする前に、端末間の保留中データを同期してください。" } } } },
    "settings.privacy.details.delete.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Removing data" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "データの削除" } } } },
    "settings.privacy.details.delete.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deleting a home removes its counters and related histories from the app. Existing Apple device backups may retain earlier copies until those backups are updated or deleted. Remove an iPad pairing code in Settings. Delete exported files at the location you chose." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホームを削除すると、アプリ内のカウンターと関連履歴が削除されます。Appleの既存バックアップには、更新または削除するまで以前のデータが残る場合があります。iPadのペアリングコードは設定から削除できます。書き出したファイルは選んだ保存先で削除してください。" } } } },
    "settings.privacy.policyLink" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read the full Privacy Policy" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライバシーポリシー全文を読む" } } } },
    "settings.privacy.policyNotConfigured" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The full Privacy Policy link is not set for this build." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このビルドにはプライバシーポリシーのURLが設定されていません。" } } } },
    "settings.support" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Support" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サポート" } } } },
    "settings.support.contact" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Contact and help" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "お問い合わせ・ヘルプ" } } } },
    "settings.support.notConfigured" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A support link is not set for this build." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このビルドにはサポートページのURLが設定されていません。" } } } },
    "settings.backup" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local backup" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカルバックアップ" } } } },
    "settings.backup.prepare" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prepare backup" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップを作成" } } } },
    "settings.backup.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create a JSON copy of homes, cards, counters, event history, cycle time samples, and settings. Choose where to save or share it. Backups are limited to 64 MiB and 500,000 records." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホーム、カード、カウンター、イベント履歴、サイクルタイム記録、設定をJSONに書き出します。保存先や共有先は作成後に選べます。バックアップの上限は64 MiBまたは50万件です。" } } } },
    "settings.backup.error" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Backup could not be created" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップを作成できませんでした" } } } },
    "settings.backup.errorMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The local data could not be read. Your stored data has not been changed." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカルデータを読み取れませんでした。保存済みデータは変更されていません。" } } } },
    "settings.backup.ready" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup is ready. Choose an app or location to save it." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップを作成しました。保存先または共有先を選んでください。" } } } },
    "settings.backup.share" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save or share JSON backup" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "JSONバックアップを保存・共有" } } } },
    "settings.backup.preview" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Factory Tools backup" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Factory Tools バックアップ" } } } },
    "settings.backup.chooseImport" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import from JSON backup" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "JSONバックアップを取り込む" } } } },
    "settings.backup.importPreview.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review imported copy" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "取り込む内容を確認" } } } },
    "settings.backup.addCopy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add as a separate copy" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "別データとして追加" } } } },
    "settings.backup.restoreFreeCopy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore as my Free home" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "無料で使うホームとして復元" } } } },
    "settings.backup.importComplete" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Backup data was added as a separate home." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップのデータを別ホームとして追加しました。" } } } },
    "settings.backup.importPreview.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A separate copy will be added. Your current records will remain." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "別データとして追加します。現在の記録はそのまま残ります。" } } } },
    "settings.backup.preferencesKept" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current language and theme settings will stay unchanged." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在の言語とテーマの設定は変更しません。" } } } },
    "settings.backup.freeRestoreNotice" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The first restored home becomes your Free home. Existing homes and remaining restored homes stay saved and locked until Pro is active." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元する先頭のホームが無料で使うホームになります。既存ホームと残りの復元ホームは保存され、Pro利用時までロックされます。" } } } },
    "settings.backup.importedHomeSuffix" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : " (Imported)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "（取り込み）" } } } },
    "settings.backup.homes" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Homes" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホーム" } } } },
    "settings.backup.cards" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tool cards" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ツールカード" } } } },
    "settings.backup.sessions" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Counter sessions" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "カウンターセッション" } } } },
    "settings.backup.events" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Counter events" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "カウンター履歴" } } } },
    "settings.backup.commandReceipts" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Processed command receipts" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "処理済み操作レシート" } } } },
    "settings.backup.samples" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cycle Time samples" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サイクルタイム記録" } } } },
    "settings.backup.oeeRuns" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OEE results" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "OEE\u8a18\u9332" } } } },
    "settings.backup.invalidFileMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This file is not a valid, supported Factory Tools backup." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Factory Toolsの有効な対応バックアップファイルではありません。" } } } },
    "settings.backup.tooLarge" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This backup exceeds the 64 MiB or 500,000-record limit. Choose a smaller backup." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップが64 MiBまたは50万件の上限を超えています。より小さいファイルを選んでください。" } } } },
    "settings.backup.importErrorMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The copy could not be added. Existing data has been kept." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "データを追加できませんでした。既存の記録は保持されています。" } } } },
    "settings.backup.exportedAt" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exported" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き出し日時" } } } },
    "settings.backup.homeNames" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Homes in this file" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイル内のホーム" } } } },
    "settings.backup.reimportNotice" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Importing this file again will add another copy." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "同じファイルをもう一度取り込むと、さらに別のコピーが追加されます。" } } } },
    "theme.industrialDark.name" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Industrial Dark" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Industrial Dark" } } } }
  },
  "version" : "1.0"
}
