    "peer.empty.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to the iPhone and refresh its counter list." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneに接続し、カウンター一覧を更新してください。" } } } },
    "peer.dashboard" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remote counters" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートカウンター" } } } },
    "peer.disconnect" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnect" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続解除" } } } },
    "peer.status.disconnected" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnected" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "未接続" } } } },
    "peer.status.pairingRequired" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create or enter a pairing code first." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "先にペアリングコードを作成または入力してください。" } } } },
    "peer.status.waiting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for the iPad" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPadからの接続を待っています" } } } },
    "peer.status.starting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starting local connection" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカル接続を開始しています" } } } },
