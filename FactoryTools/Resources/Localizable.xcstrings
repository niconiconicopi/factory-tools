    "error.storeUnavailable.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Factory Tools couldn’t open its local data. It hasn’t reset the store. Try again or close and reopen the app. Keep the app installed until this is resolved." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Factory Toolsのローカルデータを開けませんでした。データの初期化は行っていません。再試行するか、アプリを終了して再度開いてください。解決するまではアプリを削除しないでください。" } } } },
    "error.storeUnavailable.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Data unavailable" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "データを利用できません" } } } },
    "error.saveMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Please try again." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "もう一度お試しください。" } } } },
    "error.counterEventLimit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The counter can’t record any more changes." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "カウンターにこれ以上の変更を記録できません。" } } } },
    "error.counterEventInvalid" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The previous count change can’t be undone." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "直前のカウント記録を取り消せません。" } } } },
